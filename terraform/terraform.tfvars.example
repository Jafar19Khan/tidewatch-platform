# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored, so your IP address is not published.

aws_region = "ap-south-1"

# Your public IP with /32 at the end. Find it with:
#   (Invoke-RestMethod https://checkip.amazonaws.com).Trim()
my_ip_cidr = "203.0.113.25/32"

# Your PUBLIC GitHub repository for this project (the CI server clones it).
repo_url = "https://github.com/your-name/tidewatch-platform.git"

# Optional overrides
# allow_http_cidr   = "0.0.0.0/0"    # let everyone open the website
# ci_instance_type  = "t3.small"
# k8s_instance_type = "c7i-flex.large"
