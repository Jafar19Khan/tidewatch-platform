# OPTIONAL: keep Terraform state in S3 instead of on your laptop.
#
# 1. cd bootstrap && terraform init && terraform apply   (creates the bucket)
# 2. Copy this file to backend.tf and put the bucket name in
# 3. terraform init -migrate-state
#
# "use_lockfile" needs Terraform 1.10 or newer.
terraform {
  backend "s3" {
    bucket       = "tidewatch-tfstate-123456789012"
    key          = "platform/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
